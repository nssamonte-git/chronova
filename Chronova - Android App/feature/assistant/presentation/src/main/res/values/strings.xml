    <string name="assistant_offer_line">Or: %1$s</string>
    <string name="assistant_introduction">Hi! I’m your Chronova assistant. Tap me anytime and tell me what to change, like \u201cpush build by two hours\u201d or \u201cadd a review tomorrow at three\u201d. I’ll tell you what I’ll do and ask before changing anything.</string>
    <string name="assistant_greeting">Hi! How can I help you?</string>
    <string name="assistant_say_again">I didn\u2019t catch that. Please say it again.</string>
    <string name="assistant_goodbye">I\u2019ll stop listening now. Tap the orb when you need me.</string>
    <string name="assistant_nothing_changed">Okay, nothing changed.</string>
    <string name="assistant_needs_connection">The assistant needs an internet connection.</string>
    <string name="assistant_needs_sign_in">Sign in (Account) to use the assistant.</string>
    <string name="assistant_notice_title">Talk to Chronova</string>
    <string name="assistant_notice_body">Say what to change, like \u201cpush build by two hours\u201d. Chronova reads back what it will do and asks before changing anything. Recordings and this project\u2019s task names go to ElevenLabs to write down what you said; your words and the task names and times go to OpenAI to work out and explain the changes. Your requests and answers are kept for 90 days so Chronova can learn what you prefer; they are deleted with your account.</string>
    <string name="assistant_notice_continue">Continue</string>
