<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Projects (the database) are backed up and transferred; preferences are
     not, because they hold the sign-in session, encrypted with a device-bound key. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
