<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Projects (the database) are backed up; preferences are not,
     because they hold the sign-in session, encrypted with a device-bound key that a
     restored copy couldn't use anyway. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
</full-backup-content>
